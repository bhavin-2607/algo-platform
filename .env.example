# App
SECRET_KEY=your-super-secret-key-change-this
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Database
POSTGRES_DB=algo_platform
POSTGRES_USER=algo_user
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql+asyncpg://algo_user:strong_password_here@postgres:5432/algo_platform

# Redis
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:redis_password_here@redis:6379/0

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (AES key for broker tokens)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# Shoonya / Finvasia API credentials (server-side only — never exposed to users)
# Get vendor_code + api_secret after registering at https://shoonya.com/api
SHOONYA_USER_ID=            # Your Shoonya client ID
SHOONYA_PASSWORD=           # Your Shoonya login password (SHA-256 hashed before sending)
SHOONYA_TOTP_SECRET=        # Base32 TOTP secret from your Shoonya 2FA setup (e.g. from Google Authenticator)
SHOONYA_VENDOR_CODE=        # Vendor code issued by Shoonya for API access
SHOONYA_API_SECRET=         # API secret issued by Shoonya
SHOONYA_IMEI=algo-platform-v1

# Monitoring
GRAFANA_PASSWORD=admin_password_here

# MFA
MFA_ISSUER=AlgoTradingPlatform
